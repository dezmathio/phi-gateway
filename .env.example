# Local demo credentials. They gate the proxy on your machine; they are not provider secrets.
# Override CHAT_MODEL / CHAT_API_BASE / CHAT_API_KEY to point demo-chat at OpenAI, Anthropic, or Grok.

LITELLM_MASTER_KEY=sk-phi-demo-master
LITELLM_SALT_KEY=sk-phi-demo-salt

CHAT_MODEL=openai/qwen2.5:0.5b
EMBED_MODEL=openai/all-minilm
CHAT_API_BASE=http://ollama:11434/v1
CHAT_API_KEY=ollama
